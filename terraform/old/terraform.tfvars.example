gcp_project_id = "YOUR_GCP_PROJECT_ID"
gcp_region     = "us-central1"
cluster_name   = "gpu-telemetry-demo"

# GPU pool: g2-standard-4 ships one NVIDIA L4. Swap to n1-standard-4 +
# nvidia-tesla-t4 if L4 capacity is unavailable in your zone.
gpu_machine_type   = "g2-standard-4"
gpu_type           = "nvidia-l4"
gpu_count_per_node = 1
gpu_node_count     = 1

# Spot VMs keep the demo cheap; set false if you need guaranteed capacity.
use_spot_instances = true

# Optional tuning
system_machine_type = "e2-standard-4"
system_node_count   = 1
gpu_node_max_extra  = 1
release_channel     = "REGULAR"
