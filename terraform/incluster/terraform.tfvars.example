# Target platform: selects the Helm overlay (gke -> values-gke.yaml,
# eks -> values-eks.yaml). Run your cloud's kubeconfig command first.
cloud         = "gke"
cluster_name  = "gpu-telemetry-demo"

# Optional: pin the kubeconfig context. Empty = current context.
# kubeconfig_path = "~/.kube/config"
# kube_context    = "gke_your-project_us-central1-a_gpu-telemetry-demo"

release_name = "gpu-telemetry"
namespace    = "gpu-telemetry"

# Demo workloads generate sustained GPU load and pod-to-pod TCP traffic so the
# dashboard and alerts have real data.
install_demo_workloads = true
demo_namespace         = "gpu-demo"
gpu_workload_replicas  = 1
gpu_workload_gpu_count = 1

# Optional
# grafana_admin_password = "change-me"
# helm_timeout_seconds   = 900
